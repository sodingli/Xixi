{
  "name": "xixi-companion",
  "version": "0.1.0",
  "description": "A desktop floating companion pet with chat, reminders, camera-based emotion sensing, and an OpenAI-compatible model backend.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "pack": "node scripts/dist-mac.cjs --dir-only",
    "dist": "node scripts/dist-mac.cjs",
    "dist:zip": "node scripts/dist-mac.cjs --zip-only",
    "dist:dmg": "node scripts/dist-mac.cjs --dmg-only",
    "test": "node --test"
  },
  "keywords": [
    "electron",
    "desktop-pet",
    "companion",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.sodingli.xixi",
    "productName": "皙皙",
    "asar": true,
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "package.json",
      "electron/**/*",
      "src/**/*",
      "!**/.DS_Store",
      "!**/.env",
      "!**/.env.*",
      "!src/assets/girl-reference-original.png",
      "!src/assets/girl-companion-neutral.png",
      "!images/**/*",
      "!release/**/*"
    ],
    "mac": {
      "category": "public.app-category.lifestyle",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        "zip"
      ]
    }
  }
}
